# ============================================================
# TelePoly · 环境变量模板
# 复制为 .env 并填入真实值。.env 已 gitignore，永不入库。
# ============================================================

# ---- Bot ----
TELEPOLY_BOT_TOKEN=                 # @BotFather 创建拿到
TELEPOLY_BOT_USERNAME=TelePoly_Bot  # 不带 @
OWNER_TG_IDS=                       # 运营 TG ID，多个用逗号分隔（@userinfobot 拿）
ANNOUNCE_CHANNEL_ID=                # -100xxxxxxxx，主 bot 必须是该频道管理员

# ---- 业务规则（带默认值，一般不动） ----
MIN_BET_USDT=1
MAX_BET_RATIO=0.30                  # 单人单事件 ≤ 池子 30%
EVENT_FEE_BPS=500                   # 5%
DEFAULT_LANG=en

# ---- 数据库 ----
DATABASE_URL=sqlite:///./data/telepoly.db

# ---- TRC20 钱包（Day 2 接入，今天可留空跑空架）----
WALLET_MNEMONIC=                    # 12/24 词 BIP39，**只走 Railway secrets**
TRONGRID_API_KEY=
WALLET_HOT_ADDRESS=                 # m/44'/195'/0'/0/0 派生出来的主热钱包
WALLET_MIN_CONFIRMATIONS=19
WALLET_AUTO_APPROVE_LIMIT_USDT=200

# ---- LLM（出题辅助、可选）----
LLM_API_KEY=
LLM_API_BASE=https://aiberm.com/v1
LLM_MODEL=openai/gpt-5.5

# ---- @Wallet (CryptoBot) 兜底，可选 ----
CRYPTO_PAY_TOKEN=

# ---- TeleGrowth 联动（可选，跨库共享 affiliate）----
TELEGROWTH_DB_URL=

# ---- 多 Bot 矩阵（可选，留空只跑主 bot）----
# 格式: id:token:username:lang，多个用 "|" 分隔
# 例: cn:8xxx:TelePoly_CN_Bot:zh|africa:9xxx:TelePoly_Africa_Bot:en
TELEPOLY_BOT_MATRIX=

# ---- 运营后台 ----
ADMIN_PASSWORD=                     # admin_web 登录密码（不配则本地裸跑放行；生产必须配）

# ---- Mini App ----
MINIAPP_BASE_URL=                   # Railway public URL（必须 https://），如 https://telepoly.up.railway.app
                                    # 配了 bot 卡片才会出现"📈 Live chart & bet"按钮

# ---- 跨 Bot 共享钱包 API ----
WALLET_API_KEY=                     # 其他 Bot（如 KickAI）调用 /api/wallet/* 时的认证 token
